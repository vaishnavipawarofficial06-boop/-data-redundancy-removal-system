# Copy to .env locally. Never commit real credentials or secrets.
# SQLite default:
DATABASE_URL=sqlite:///./data.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://app_user:change-me@localhost:5432/dataguard

# Authentication is disabled by default for local compatibility.
# Enable it for deployments and set all three values.
AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

# Optional Redis cache for dashboard statistics:
# REDIS_URL=redis://localhost:6379/0
